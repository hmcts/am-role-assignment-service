<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{dd-MM-yyyy HH:mm:ss.SSS} %thread %X{correlationId} [%-5level] %class{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- JUnit Test settings -->
  <logger name="uk.gov.hmcts.reform.roleassignment.auditlog.AuditInterceptor" level="debug"/>

  <!-- additional drool logging for integraton test reviews -->
  <logger name="uk.gov.hmcts.reform.roleassignment.domain.service.common.ValidationModelService" level="debug"/>

  <root level="info">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
